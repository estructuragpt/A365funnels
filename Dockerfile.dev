# Development image: dependencies are installed once, while the checkout is
# mounted by docker-compose.override.yml for Astro hot reload.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@10.11.1

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma/
COPY prisma.config.ts ./
RUN pnpm install --frozen-lockfile
RUN pnpm exec prisma generate

ENV NODE_ENV=development HOST=0.0.0.0 PORT=4321
EXPOSE 4321

CMD ["pnpm", "dev", "--", "--host", "0.0.0.0"]
